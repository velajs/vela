{
  "name": "vela-api-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --include-runtime=false --strict-vars=false --env-file .dev.vars.example",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "dev": "npm run build:web && vite dev --port 8790",
    "build": "npm run client:generate && npm run build:web && vite build",
    "build:web": "esbuild web/main.ts --bundle --format=esm --outfile=public/main.js && node scripts/copy-web.mjs",
    "preview": "vite preview --port 8790",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply vela-api-starter --local",
    "client:generate": "node node_modules/@velajs/cli/dist/index.js client generate --out web/api.generated.ts",
    "client:check": "node node_modules/@velajs/cli/dist/index.js client generate --out web/api.generated.ts --check",
    "studio": "vela studio --url http://localhost:8790 --port 8791",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@velajs/better-auth": "workspace:*",
    "@velajs/client": "workspace:*",
    "@velajs/cloudflare": "workspace:*",
    "@velajs/crud": "workspace:*",
    "@velajs/crud-drizzle": "workspace:*",
    "@velajs/live-protocol": "workspace:*",
    "@velajs/studio": "workspace:*",
    "@velajs/vela": "workspace:*",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@velajs/cli": "workspace:*",
    "@velajs/studio-host": "workspace:*",
    "@velajs/studio-ui": "workspace:*",
    "esbuild": "^0.28.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "ws": "^8.18.3"
  }
}
