{
  "name": "vela-api-starter",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "run_worker_first": [
      "/api/*",
      "/todos",
      "/todos/*",
      "/me",
      "/healthz",
      "/openapi.json",
      "/_vela/*",
      "/rooms/*",
    ],
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8790",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vela-api-starter",
      "database_id": "local-api-starter",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_ROOM",
        "class_name": "LiveRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveRoom"],
    },
  ],
}
