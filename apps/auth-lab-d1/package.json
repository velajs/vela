{
  "name": "auth-lab-d1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 execute velajs_better_auth_d1 --local --file=migrations/0000_initial.sql",
    "smoke": "pnpm run db:reset && pnpm run build && node scripts/smoke.ts",
    "types": "wrangler types --include-runtime=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@velajs/better-auth": "workspace:*",
    "@velajs/cloudflare": "workspace:*",
    "@velajs/vela": "workspace:*",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
