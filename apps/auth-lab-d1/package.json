{
  "name": "auth-lab-d1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 execute velajs_better_auth_d1 --local --file=migrations/0000_initial.sql",
    "dev": "pnpm run build && wrangler dev --local --port 8789",
    "wrangler:smoke": "pnpm run db:reset && pnpm run build && node dist/wrangler-smoke.js",
    "types": "wrangler types --include-runtime=false",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@velajs/better-auth": "workspace:*",
    "@velajs/cloudflare": "workspace:*",
    "@velajs/vela": "workspace:*",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@swc/cli": "^0.8.0",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
