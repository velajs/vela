{
  "name": "graphql-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Executable GraphQL schema with Vela resolver DI on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@velajs/cloudflare": "workspace:*",
    "@velajs/graphql": "workspace:*",
    "@velajs/vela": "workspace:*",
    "graphql": "16.14.2",
    "graphql-yoga": "5.24.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
