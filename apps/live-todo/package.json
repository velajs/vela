{
  "name": "live-todo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Realtime todo + presence demo for @velajs/vela/live: node transport and Cloudflare Durable Object variants, driven by the published @velajs/client.",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths",
    "bundle:web": "esbuild web/main.ts --bundle --format=esm --outfile=web/main.js",
    "start": "pnpm run build && pnpm run bundle:web && node dist/server-node.js",
    "typecheck": "tsc --noEmit",
    "start:cf": "pnpm run build && pnpm run bundle:web && wrangler dev --port 8789"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/node-ws": "^1.2.0",
    "@velajs/client": "workspace:*",
    "@velajs/cloudflare": "workspace:*",
    "@velajs/vela": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:",
    "@velajs/live-protocol": "workspace:*"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.0",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "^0.25.0",
    "typescript": "catalog:",
    "wrangler": "catalog:",
    "@cloudflare/workers-types": "catalog:"
  }
}
