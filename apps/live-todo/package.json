{
  "name": "live-todo",
  "version": "0.0.0",
  "private": true,
  "description": "Realtime todo + presence demo for @velajs/vela/live: node transport and Cloudflare Durable Object variants, driven by the published @velajs/client.",
  "type": "module",
  "scripts": {
    "bundle:web": "esbuild web/main.ts web/index.html --bundle --format=esm --outdir=public --loader:.html=copy",
    "dev": "pnpm run bundle:web && vite dev",
    "build": "pnpm run bundle:web && vite build && tsdown",
    "preview": "vite preview",
    "start": "pnpm run bundle:web && tsdown && node dist/node/server-node.js",
    "test": "vitest run",
    "types": "wrangler types --include-runtime=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/node-ws": "^1.2.0",
    "@velajs/client": "workspace:*",
    "@velajs/cloudflare": "workspace:*",
    "@velajs/live-protocol": "workspace:*",
    "@velajs/vela": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "^0.28.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
