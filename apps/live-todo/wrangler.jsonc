{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-todo",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static UI (index.html + the esbuild bundle of web/main.ts). API + upgrade routes
  // fall through to the worker. Vite serves and builds public/ as the assets.
  "assets": { "directory": "./public" },
  "kv_namespaces": [{ "binding": "TODOS", "id": "todos-local-dev" }],
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOM", "class_name": "LiveRoom" }],
  },
  "migrations": [
    // SQLite-backed DO: required for the durable live cursor log (real resume).
    { "tag": "v1", "new_sqlite_classes": ["LiveRoom"] },
  ],
}
