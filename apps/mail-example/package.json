{
  "name": "vela-mail-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm run build:portable",
    "build:portable": "tsdown src/index.ts --format esm --platform neutral --out-dir dist/portable",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.workers.json",
    "start": "node dist/portable/index.js",
    "test": "node dist/portable/index.js",
    "test:workers": "vitest run",
    "cf:types": "wrangler types --include-runtime=false"
  },
  "dependencies": {
    "@velajs/cloudflare": "workspace:*",
    "@velajs/mail": "workspace:*",
    "@velajs/vela": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
