    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@swc/core": "catalog:",
    "esbuild": "^0.28.1",
    "miniflare": "5.20260918.0-alpha",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
