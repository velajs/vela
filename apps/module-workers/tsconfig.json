{
  // Shared options. Each Worker type-checks as its own program
  // (tsconfig.<worker>.json) with its generated worker-configuration.<worker>.d.ts,
  // so ENV carries only the bindings of that Worker's Wrangler file.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  // This program checks the shared contracts and the Vite config.
  "include": ["src/contracts.ts", "*.config.ts"]
}
