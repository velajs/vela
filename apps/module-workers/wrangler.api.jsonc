{
  "name": "module-api",
  "main": "src/api.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "services": [
    {
      "binding": "NATIVE_CATALOG",
      "service": "module-catalog",
      "entrypoint": "Catalog",
      "props": { "caller": "example-api" },
    },
    {
      "binding": "UNTRUSTED_CATALOG",
      "service": "module-catalog",
      "entrypoint": "Catalog",
      "props": { "caller": "untrusted", "subject": "alice" },
    },
    {
      "binding": "CATALOG",
      "service": "module-catalog",
    },
    {
      "binding": "ACCOUNTS",
      "service": "module-accounts",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASKS",
        "queue": "module-tasks",
      },
    ],
  },
}
