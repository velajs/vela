{
  "name": "module-jobs",
  "main": "src/jobs.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "RESULTS",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "module-tasks",
        "max_batch_size": 10,
        "max_retries": 3,
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
}
