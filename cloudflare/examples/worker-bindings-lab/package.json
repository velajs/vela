{
  "name": "worker-bindings-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fictional Cloudflare Worker used as a real @velajs/cloudflare example project.",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "smoke": "node dist/smoke.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@velajs/cloudflare": "workspace:*",
    "@velajs/vela": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@swc/cli": "^0.8.0",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
