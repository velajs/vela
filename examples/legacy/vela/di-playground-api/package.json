{
  "name": "di-playground-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fictional diagnostics API used as a real advanced @velajs/vela DI example project.",
  "scripts": {
    "build:vela": "pnpm --dir ../.. build",
    "sync:deps": "pnpm run build:vela && pnpm install",
    "build": "pnpm run sync:deps && rm -rf dist && swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "dev": "pnpm run build && node dist/server.js",
    "start": "node dist/server.js",
    "smoke": "pnpm run build && node dist/smoke.js",
    "curl:test": "bash scripts/curl-all.sh",
    "test": "pnpm run sync:deps && vitest run",
    "typecheck": "pnpm run sync:deps && tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@velajs/vela": "file:../..",
    "hono": "^4",
    "zod": "^4"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.11",
    "@types/node": "^22",
    "typescript": "^5",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
