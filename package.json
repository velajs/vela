{
  "name": "@velajs/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:workers": "pnpm -r --workspace-concurrency=1 --if-present run test:workers && pnpm --dir vela run test:workers:als",
    "verify": "pnpm check:workspace && pnpm build && pnpm api:check && pnpm typecheck && pnpm check:skill && pnpm docs:check && pnpm test && pnpm test:conformance && pnpm test:workers",
    "test:conformance": "pnpm --dir crud exec vitest run tests",
    "check:workspace": "node scripts/check-workspace.mjs",
    "api:check": "pnpm --dir vela api:check",
    "docs": "pnpm --dir vela docs",
    "docs:check": "pnpm --dir vela docs:check",
    "check:skill": "pnpm --dir vela check:skill",
    "changeset": "changeset",
    "version-packages": "node scripts/version-packages.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:consumer": "node scripts/release-consumer.mjs",
    "release:preflight": "node scripts/release-publish.mjs --dry-run",
    "release:publish": "node scripts/release-publish.mjs",
    "release:check": "pnpm verify && pnpm peers check && pnpm audit --audit-level=high && pnpm release:pack && pnpm release:consumer && pnpm release:preflight"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@libsql/client": "^0.17.4",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@velajs/vela": "workspace:*",
    "@vitest/runner": "catalog:",
    "@vitest/snapshot": "catalog:",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:",
    "miniflare": "5.20260918.0-alpha",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
