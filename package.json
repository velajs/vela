{
  "name": "edgest",
  "version": "0.1.0",
  "description": "NestJS-compatible framework for edge runtimes, powered by Hono",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crud": {
      "types": "./dist/crud/index.d.ts",
      "import": "./dist/crud/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4",
    "reflect-metadata": "^0.2"
  },
  "peerDependencies": {
    "hono-crud": ">=0.4.0",
    "@hono/zod-openapi": ">=0.9",
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "hono-crud": {
      "optional": true
    },
    "@hono/zod-openapi": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/zod-openapi": "^0.19",
    "@types/bun": "latest",
    "hono-crud": "^0.4.4",
    "typescript": "^5",
    "zod": "^4"
  }
}
