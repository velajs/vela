{
  "name": "@velajs/cloudflare",
  "version": "1.10.1",
  "description": "Cloudflare Workers integration for Vela framework",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "d1",
    "decorators",
    "edge",
    "framework",
    "kv",
    "queues",
    "r2",
    "vela"
  ],
  "homepage": "https://github.com/velajs/cloudflare#readme",
  "bugs": {
    "url": "https://github.com/velajs/cloudflare/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/cloudflare.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.config.workers.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:preflight": "npm view @velajs/vela@2.0.0 version && npm view @velajs/feature-flags@1.0.0 version && npm view @velajs/mail@1.0.0 version && npm view @velajs/workflow@0.1.0 version",
    "release:check": "node scripts/check-release-lock.mjs && pnpm verify && pnpm audit --audit-level=high",
    "release": "pnpm release:preflight && pnpm release:check && changeset publish",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm test:workers && pnpm publint && pnpm attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@cloudflare/workers-types": "^4.20260624.1",
    "@swc/core": "catalog:",
    "@velajs/feature-flags": "^1.0.0",
    "@velajs/mail": "^1.0.0",
    "@velajs/vela": "^2.0.0",
    "@velajs/workflow": "^0.1.0",
    "hono": "^4.12.27",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "@velajs/feature-flags": ">=1.0.0",
    "@velajs/mail": ">=1.0.0",
    "@velajs/vela": ">=2.0.0",
    "@velajs/workflow": ">=0.1.0",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "@velajs/feature-flags": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
