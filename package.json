{
  "name": "@velajs/vela",
  "version": "1.19.1",
  "description": "NestJS-compatible framework for edge runtimes, powered by Hono",
  "keywords": [
    "bun",
    "cloudflare-workers",
    "decorators",
    "deno",
    "dependency-injection",
    "edge",
    "framework",
    "hono",
    "nestjs",
    "typescript"
  ],
  "homepage": "https://github.com/velajs/vela#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/metadata.js",
    "./dist/schedule-node/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./streaming": {
      "types": "./dist/streaming/index.d.ts",
      "import": "./dist/streaming/index.js"
    },
    "./schedule-node": {
      "types": "./dist/schedule-node/index.d.ts",
      "import": "./dist/schedule-node/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "import": "./dist/websocket/index.js"
    },
    "./websocket-node": {
      "types": "./dist/websocket-node/index.d.ts",
      "import": "./dist/websocket-node/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./seeder": {
      "types": "./dist/seeder/index.d.ts",
      "import": "./dist/seeder/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.config.workers.ts",
    "test:workers:als": "vitest run --config vitest.config.workers-als.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.type-tests.json",
    "check:skill": "node scripts/check-skill.mjs",
    "docs": "pnpm --dir tools/docs docs",
    "docs:check": "pnpm --dir tools/docs docs:check",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-skill-version.mjs",
    "release": "pnpm build && changeset publish",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm check:skill && pnpm docs:check && pnpm test && pnpm test:workers && pnpm test:workers:als && pnpm publint && pnpm attw"
  },
  "dependencies": {
    "@velajs/errors": "^1.0.0",
    "@velajs/live-protocol": "^1.0.0",
    "hono": "^4.12.26"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@swc/core": "catalog:",
    "@types/bun": "latest",
    "@vitest/runner": "catalog:",
    "@vitest/snapshot": "catalog:",
    "intl-messageformat": "^11.2.9",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "intl-messageformat": ">=10"
  },
  "peerDependenciesMeta": {
    "intl-messageformat": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
