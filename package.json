{
  "name": "@velajs/vela",
  "version": "1.9.0",
  "description": "NestJS-compatible framework for edge runtimes, powered by Hono",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./streaming": {
      "types": "./dist/streaming/index.d.ts",
      "import": "./dist/streaming/index.js"
    },
    "./schedule-node": {
      "types": "./dist/schedule-node/index.d.ts",
      "import": "./dist/schedule-node/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.config.workers.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/metadata.js",
    "./dist/schedule-node/index.js"
  ],
  "keywords": [
    "edge",
    "hono",
    "nestjs",
    "framework",
    "decorators",
    "dependency-injection",
    "cloudflare-workers",
    "deno",
    "bun",
    "typescript"
  ],
  "author": "ksh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git"
  },
  "homepage": "https://github.com/velajs/vela#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.12.26"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.41",
    "@types/bun": "latest",
    "@vitest/runner": "^4.1.9",
    "@vitest/snapshot": "^4.1.9",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  }
}
