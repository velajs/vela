{
  "name": "@velajs/storage",
  "version": "0.3.1",
  "description": "Edge-first, driver-based object/file storage for the Vela framework",
  "keywords": [
    "cloudflare-workers",
    "edge",
    "framework",
    "multipart",
    "object-storage",
    "presigned-url",
    "r2",
    "s3",
    "storage",
    "vela"
  ],
  "homepage": "https://github.com/velajs/storage#readme",
  "bugs": {
    "url": "https://github.com/velajs/storage/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/storage.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./drivers/memory": {
      "types": "./dist/drivers/memory/index.d.ts",
      "import": "./dist/drivers/memory/index.js"
    },
    "./drivers/s3": {
      "types": "./dist/drivers/s3/index.d.ts",
      "import": "./dist/drivers/s3/index.js"
    },
    "./drivers/r2": {
      "types": "./dist/drivers/r2/index.d.ts",
      "import": "./dist/drivers/r2/index.js"
    },
    "./drivers/r2-http": {
      "types": "./dist/drivers/r2-http/index.d.ts",
      "import": "./dist/drivers/r2-http/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./storagesdk": {
      "types": "./dist/storagesdk/index.d.ts",
      "import": "./dist/storagesdk/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.config.workers.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm test:workers && pnpm publint && pnpm attw"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@cloudflare/workers-types": "^4.20260624.1",
    "@swc/core": "catalog:",
    "@velajs/testing": "^0.4.0",
    "@velajs/vela": "^1.12.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.12.27",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "@velajs/vela": ">=1.11.0",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
