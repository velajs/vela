{
  "name": "@velajs/crud",
  "version": "1.1.0",
  "description": "CRUD module for Vela framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "sideEffects": false,
  "keywords": [
    "vela",
    "crud",
    "hono",
    "hono-crud",
    "decorators",
    "edge",
    "framework"
  ],
  "author": "ksh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/crud.git"
  },
  "homepage": "https://github.com/velajs/crud#readme",
  "bugs": {
    "url": "https://github.com/velajs/crud/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@hono/zod-openapi": ">=0.9",
    "@velajs/vela": ">=1.5.0",
    "hono": ">=4",
    "hono-crud": ">=0.7.0",
    "zod": ">=4"
  },
  "devDependencies": {
    "@hono/zod-openapi": "^0.19",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.11",
    "@velajs/crud": "link:",
    "@velajs/vela": "^1.5.0",
    "drizzle-orm": "^0.36.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4",
    "hono-crud": "^0.7.0",
    "typescript": "^5",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.18",
    "zod": "^4"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
