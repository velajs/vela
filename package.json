{
  "name": "@velajs/crud-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && vitest run tests",
    "test:conformance": "vitest run tests",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "pnpm --filter @velajs/crud --filter @velajs/crud-drizzle --filter @velajs/crud-memory --no-bail exec publint",
    "attw": "pnpm --filter @velajs/crud --filter @velajs/crud-drizzle --filter @velajs/crud-memory --no-bail exec attw --pack . --profile esm-only",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:preflight": "npm view @velajs/vela@2.0.0 version",
    "release:check": "node scripts/check-release-lock.mjs && pnpm verify && pnpm audit --audit-level=high",
    "release": "pnpm release:preflight && pnpm release:check && changeset publish",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm publint && pnpm attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@libsql/client": "^0.17.4",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@velajs/vela": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:",
    "zod": "^4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
