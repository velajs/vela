{
  "name": "@velajs/authz",
  "version": "1.1.0",
  "description": "Framework-agnostic permission/role engine for Vela: defineRole, fail-closed can(), composition + masking helpers",
  "keywords": [
    "authorization",
    "authz",
    "framework",
    "permissions",
    "rbac",
    "vela"
  ],
  "homepage": "https://github.com/velajs/authz#readme",
  "bugs": {
    "url": "https://github.com/velajs/authz/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/authz.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vela": {
      "types": "./dist/vela/index.d.ts",
      "import": "./dist/vela/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:preflight": "npm view @velajs/vela@1.21.0 version",
    "release:check": "node scripts/check-release-lock.mjs && pnpm verify && pnpm audit --audit-level=high",
    "release": "pnpm release:preflight && pnpm release:check && changeset publish",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm publint && pnpm attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@velajs/vela": "^1.21.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@velajs/vela": ">=1.21.0 <2"
  },
  "peerDependenciesMeta": {
    "@velajs/vela": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
