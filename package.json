{
  "name": "@velajs/testing",
  "version": "0.2.0",
  "description": "Testing utilities for Vela framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "sideEffects": false,
  "keywords": [
    "vela",
    "testing",
    "test",
    "mock",
    "override",
    "edge",
    "framework"
  ],
  "author": "ksh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/testing.git"
  },
  "homepage": "https://github.com/velajs/testing#readme",
  "bugs": {
    "url": "https://github.com/velajs/testing/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@velajs/vela": ">=1.1.0",
    "hono": ">=4"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.11",
    "@types/bun": "latest",
    "@velajs/vela": "^1.1.0",
    "hono": "^4",
    "typescript": "^5",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
