{
  "name": "@velajs/cloudflare-access",
  "version": "0.1.0",
  "description": "Zero Trust / OIDC identity for Vela: RS256-pinned JWKS verification, fail-closed resolveIdentity + composeResolvers, an issuer-preset generic JWKS adapter, and a Vela guard/module bridge into @velajs/authz",
  "keywords": [
    "access",
    "cloudflare",
    "jwks",
    "jwt",
    "oidc",
    "vela",
    "zero-trust"
  ],
  "homepage": "https://github.com/velajs/cloudflare-access#readme",
  "bugs": {
    "url": "https://github.com/velajs/cloudflare-access/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/cloudflare-access.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vela": {
      "types": "./dist/vela/index.d.ts",
      "import": "./dist/vela/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:preflight": "npm view @velajs/vela@2.0.0 version && npm view @velajs/authz@2.0.0 version",
    "release:check": "node scripts/check-release-lock.mjs && pnpm verify && pnpm audit --audit-level=high",
    "release": "pnpm release:preflight && pnpm release:check && changeset publish",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm publint && pnpm attw"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@swc/core": "catalog:",
    "@velajs/authz": "^2.0.0",
    "@velajs/vela": "^2.0.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@velajs/authz": ">=2.0.0",
    "@velajs/vela": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@velajs/authz": {
      "optional": true
    },
    "@velajs/vela": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
