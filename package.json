{
  "name": "@velajs/cloudflare",
  "version": "1.7.0",
  "description": "Cloudflare Workers integration for Vela framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "sideEffects": false,
  "keywords": [
    "vela",
    "cloudflare",
    "cloudflare-workers",
    "kv",
    "d1",
    "r2",
    "queues",
    "edge",
    "framework",
    "decorators"
  ],
  "author": "ksh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/cloudflare.git"
  },
  "homepage": "https://github.com/velajs/cloudflare#readme",
  "bugs": {
    "url": "https://github.com/velajs/cloudflare/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "@velajs/vela": ">=1.11.0",
    "hono": ">=4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260624.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@velajs/vela": "^1.12.0",
    "hono": "^4.12.27",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
