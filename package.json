{
  "name": "@velajs/testing",
  "version": "0.5.0",
  "description": "Testing utilities for Vela framework",
  "keywords": [
    "edge",
    "framework",
    "mock",
    "override",
    "test",
    "testing",
    "vela"
  ],
  "homepage": "https://github.com/velajs/testing#readme",
  "bugs": {
    "url": "https://github.com/velajs/testing/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/testing.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/websocket-node/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./websocket-node": {
      "types": "./dist/websocket-node/index.d.ts",
      "import": "./dist/websocket-node/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm publint && pnpm attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@velajs/vela": "^1.12.0",
    "hono": "^4.12.26",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@hono/node-server": ">=1",
    "@hono/node-ws": ">=1",
    "@velajs/vela": ">=1.11.0",
    "hono": ">=4",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@hono/node-ws": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
