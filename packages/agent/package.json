{
  "name": "@velajs/agent",
  "version": "1.29.0",
  "description": "Durable AI tool orchestration, scoped thread storage, and human approvals over Vela workflows.",
  "keywords": [
    "agent",
    "ai",
    "cloudflare-workflows",
    "durable-execution",
    "framework",
    "hitl",
    "llm",
    "tool-loop",
    "vela"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/agent"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm publint && pnpm attw"
  },
  "dependencies": {
    "@cfworker/json-schema": "catalog:",
    "@types/json-schema": "catalog:",
    "@velajs/errors": "workspace:*",
    "@velajs/workflow": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@velajs/ai": "workspace:*",
    "@velajs/mail": "workspace:*",
    "@velajs/workflow": "workspace:*",
    "ai": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@velajs/ai": "workspace:^1.0.1",
    "@velajs/mail": "workspace:^1.32.0",
    "ai": "^7.0.26",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@velajs/ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "@velajs/mail": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
