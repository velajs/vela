{
  "name": "@velajs/ai",
  "version": "1.3.0",
  "description": "Provider-neutral model resolution and tenant-scoped retrieval for Vela and the AI SDK",
  "keywords": [
    "ai",
    "embeddings",
    "framework",
    "rag",
    "vela",
    "vercel-ai-sdk"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/ai#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/ai"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rag": {
      "types": "./dist/rag/index.d.ts",
      "import": "./dist/rag/index.js"
    },
    "./ai-search": {
      "types": "./dist/ai-search/index.d.ts",
      "import": "./dist/ai-search/index.js"
    },
    "./vectorize": {
      "types": "./dist/vectorize/index.d.ts",
      "import": "./dist/vectorize/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.config.workers.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm publint && pnpm attw",
    "example": "node examples/tenant-search.mjs",
    "test:vectorize:live": "node scripts/vectorize-live.mjs"
  },
  "dependencies": {
    "@types/json-schema": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "ai": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "ai": "^7.0.26"
  },
  "engines": {
    "node": ">=24"
  }
}
