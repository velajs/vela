{
  "name": "@velajs/authz-cedar",
  "version": "2.0.0",
  "description": "Portable authz-cedar for Vela and Cloudflare Workers",
  "keywords": [
    "authz-cedar",
    "cloudflare-workers",
    "vela"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/authz-cedar#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/authz-cedar"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_LICENSES"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vela": {
      "types": "./dist/vela/index.d.ts",
      "import": "./dist/vela/index.js"
    },
    "./plan": {
      "types": "./dist/plan.d.ts",
      "import": "./dist/plan.js"
    },
    "./vocabulary": {
      "types": "./dist/vocabulary.d.ts",
      "import": "./dist/vocabulary.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "import": "./dist/cloudflare/index.js"
    },
    "./d1": {
      "types": "./dist/d1/index.d.ts",
      "import": "./dist/d1/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js"
    },
    "./durable-objects": {
      "types": "./dist/durable-objects/index.d.ts",
      "import": "./dist/durable-objects/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-wasm.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm publint && pnpm attw"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.12.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "catalog:",
    "@velajs/vela": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@velajs/vela": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@velajs/vela": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
