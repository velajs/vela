{
  "name": "@velajs/cloudflare",
  "version": "1.33.0",
  "description": "Cloudflare Workers integration for Vela framework",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "d1",
    "decorators",
    "edge",
    "framework",
    "kv",
    "queues",
    "r2",
    "vela"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/cloudflare#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./durable-objects": {
      "types": "./dist/durable-objects.d.ts",
      "import": "./dist/durable-objects.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "import": "./dist/email.js"
    },
    "./entrypoints": {
      "types": "./dist/entrypoints.d.ts",
      "import": "./dist/entrypoints.js"
    },
    "./pipelines": {
      "types": "./dist/pipelines.d.ts",
      "import": "./dist/pipelines.js"
    },
    "./queues": {
      "types": "./dist/queues.d.ts",
      "import": "./dist/queues.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./tail": {
      "types": "./dist/tail.d.ts",
      "import": "./dist/tail.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.config.workers.ts",
    "worker-size:check": "node ../vela/scripts/check-worker-size.mjs --baseline worker-size.json",
    "worker-size:update": "node ../vela/scripts/check-worker-size.mjs --baseline worker-size.json --update",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.workers-test.json && tsc --noEmit -p tsconfig.package-tests.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm worker-size:check && pnpm typecheck && pnpm test && pnpm test:workers && pnpm publint && pnpm attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@swc/core": "catalog:",
    "@velajs/feature-flags": "workspace:*",
    "@velajs/storage": "workspace:*",
    "@velajs/testing": "workspace:*",
    "@velajs/vela": "workspace:*",
    "hono": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "@velajs/feature-flags": "workspace:^",
    "@velajs/storage": "workspace:^",
    "@velajs/testing": "workspace:^",
    "@velajs/vela": "workspace:^",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "@velajs/feature-flags": {
      "optional": true
    },
    "@velajs/storage": {
      "optional": true
    },
    "@velajs/testing": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
