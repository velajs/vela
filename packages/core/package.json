{
  "name": "@velajs/crud",
  "version": "1.19.1",
  "description": "Native CRUD module for the Vela framework",
  "keywords": [
    "crud",
    "decorators",
    "edge",
    "framework",
    "hono",
    "vela"
  ],
  "homepage": "https://github.com/velajs/crud#readme",
  "bugs": {
    "url": "https://github.com/velajs/crud/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/crud.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js"
    },
    "./csv": {
      "types": "./dist/csv/index.d.ts",
      "import": "./dist/csv/index.js"
    },
    "./envelope": {
      "types": "./dist/envelope/index.d.ts",
      "import": "./dist/envelope/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js"
    },
    "./policies": {
      "types": "./dist/policies/index.d.ts",
      "import": "./dist/policies/index.js"
    },
    "./multi-tenant": {
      "types": "./dist/multi-tenant/index.d.ts",
      "import": "./dist/multi-tenant/index.js"
    },
    "./versioning": {
      "types": "./dist/versioning/index.d.ts",
      "import": "./dist/versioning/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@velajs/vela": "^1.21.0",
    "hono": "^4",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4"
  },
  "peerDependencies": {
    "@velajs/vela": ">=1.21.0 <2",
    "hono": ">=4",
    "zod": ">=4"
  },
  "engines": {
    "node": ">=24"
  }
}
