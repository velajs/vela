{
  "name": "@velajs/crud",
  "version": "1.8.0",
  "description": "Native CRUD module for the Vela framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js"
    },
    "./envelope": {
      "types": "./dist/envelope/index.d.ts",
      "import": "./dist/envelope/index.js"
    },
    "./policies": {
      "types": "./dist/policies/index.d.ts",
      "import": "./dist/policies/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "sideEffects": false,
  "keywords": [
    "vela",
    "crud",
    "hono",
    "decorators",
    "edge",
    "framework"
  ],
  "author": "ksh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/crud.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/velajs/crud#readme",
  "bugs": {
    "url": "https://github.com/velajs/crud/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@hono/zod-openapi": ">=1.0.0",
    "@velajs/vela": ">=1.17.0",
    "hono": ">=4",
    "hono-crud": ">=0.13.0",
    "zod": ">=4"
  },
  "devDependencies": {
    "@hono-crud/memory": "^0.1.12",
    "@hono/zod-openapi": "^1.4.0",
    "@velajs/vela": "^1.17.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4",
    "hono-crud": "^0.13.15",
    "zod": "^4"
  }
}
