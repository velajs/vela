{
  "name": "@velajs/crud-durable-objects",
  "version": "1.23.0",
  "description": "Durable Object SQLite adapter for Vela CRUD",
  "keywords": [
    "cloudflare-workers",
    "crud",
    "durable-objects",
    "vela"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/crud-durable-objects#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/crud-durable-objects"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm publint && pnpm attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@velajs/crud": "workspace:*",
    "@velajs/crud-drizzle": "workspace:*",
    "@velajs/vela": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@velajs/crud": "workspace:^",
    "@velajs/crud-drizzle": "workspace:^",
    "drizzle-orm": ">=0.45.0"
  },
  "engines": {
    "node": ">=24"
  }
}
