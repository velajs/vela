{
  "name": "@velajs/crud-memory",
  "version": "3.0.0",
  "description": "In-memory adapter for @velajs/crud \u2014 tests, prototypes, and examples",
  "keywords": [
    "adapter",
    "crud",
    "edge",
    "memory",
    "vela"
  ],
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/crud-memory"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@velajs/crud": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@velajs/crud": "workspace:^",
    "zod": ">=4"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/velajs/vela/tree/main/packages/crud-memory#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  }
}
