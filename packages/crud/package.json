{
  "name": "@velajs/crud",
  "version": "3.0.0",
  "description": "Native CRUD module for the Vela framework",
  "keywords": [
    "crud",
    "decorators",
    "edge",
    "framework",
    "hono",
    "vela"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/crud#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/crud"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js"
    },
    "./csv": {
      "types": "./dist/csv/index.d.ts",
      "import": "./dist/csv/index.js"
    },
    "./envelope": {
      "types": "./dist/envelope/index.d.ts",
      "import": "./dist/envelope/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js"
    },
    "./policies": {
      "types": "./dist/policies/index.d.ts",
      "import": "./dist/policies/index.js"
    },
    "./multi-tenant": {
      "types": "./dist/multi-tenant/index.d.ts",
      "import": "./dist/multi-tenant/index.js"
    },
    "./versioning": {
      "types": "./dist/versioning/index.d.ts",
      "import": "./dist/versioning/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@velajs/vela": "workspace:*",
    "hono": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@velajs/vela": "workspace:^",
    "hono": ">=4",
    "zod": ">=4"
  },
  "engines": {
    "node": ">=24"
  }
}
