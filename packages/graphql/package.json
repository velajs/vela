{
  "name": "@velajs/graphql",
  "version": "2.0.0",
  "description": "Optional executable-schema GraphQL integration for Vela",
  "keywords": [
    "cloudflare-workers",
    "graphql",
    "vela"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/graphql#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/graphql"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./yoga": {
      "types": "./dist/yoga.d.ts",
      "import": "./dist/yoga.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm test:workers && pnpm publint && pnpm attw",
    "test:workers": "vitest run --config vitest.config.workers.ts"
  },
  "dependencies": {
    "@graphql-tools/utils": "^12.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@velajs/authz": "workspace:*",
    "@velajs/better-auth": "workspace:*",
    "@velajs/cloudflare": "workspace:*",
    "@velajs/tenant": "workspace:*",
    "@velajs/vela": "workspace:*",
    "graphql": "16.14.2",
    "graphql-yoga": "5.24.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@velajs/vela": "workspace:^",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.1"
  },
  "peerDependenciesMeta": {
    "graphql-yoga": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
