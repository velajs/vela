{
  "name": "@velajs/studio-host",
  "version": "0.1.0",
  "description": "Loopback dev host serving the Vela Studio SPA and proxying the admin API",
  "keywords": [
    "admin",
    "dev-server",
    "host",
    "studio",
    "vela"
  ],
  "homepage": "https://github.com/velajs/studio#readme",
  "bugs": {
    "url": "https://github.com/velajs/studio/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/studio.git",
    "directory": "packages/host"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@velajs/studio-ui": "workspace:^",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@velajs/studio-ui": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@velajs/studio-ui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
