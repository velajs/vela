{
  "name": "@velajs/mail",
  "version": "1.34.0",
  "description": "Edge-neutral mail for Vela: a render→validate→build→dispatch pipeline behind a one-method MailTransport seam with header-injection guards hoisted above every transport, a queue-backed send path, and inbound email as a verdict-gated entrypoint kind",
  "keywords": [
    "cloudflare-workers",
    "dmarc",
    "edge",
    "email",
    "framework",
    "header-injection",
    "mail",
    "resend",
    "smtp",
    "vela"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/mail#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/mail"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transports/resend": {
      "types": "./dist/transports/resend/index.d.ts",
      "import": "./dist/transports/resend/index.js"
    },
    "./transports/cloudflare": {
      "types": "./dist/transports/cloudflare/index.d.ts",
      "import": "./dist/transports/cloudflare/index.js"
    },
    "./transports/catcher": {
      "types": "./dist/transports/catcher/index.d.ts",
      "import": "./dist/transports/catcher/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm publint && pnpm attw"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@velajs/vela": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@velajs/vela": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@velajs/vela": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
