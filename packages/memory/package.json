{
  "name": "@velajs/crud-memory",
  "version": "1.18.1",
  "description": "In-memory adapter for @velajs/crud — tests, prototypes, and examples",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "sideEffects": false,
  "keywords": [
    "vela",
    "crud",
    "adapter",
    "memory",
    "edge"
  ],
  "author": "ksh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/crud.git",
    "directory": "packages/memory"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@velajs/crud": "workspace:^",
    "zod": ">=4"
  },
  "devDependencies": {
    "@velajs/crud": "workspace:*",
    "zod": "^4"
  }
}
