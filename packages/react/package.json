    "happy-dom": "^20.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24"
  }
