{
  "name": "@velajs/studio",
  "version": "0.1.0",
  "description": "Vela Studio admin module: reserved /_vela/admin surface, @AdminRpc ops, time-travel port",
  "keywords": [
    "admin",
    "edge",
    "hono",
    "studio",
    "vela"
  ],
  "homepage": "https://github.com/velajs/studio#readme",
  "bugs": {
    "url": "https://github.com/velajs/studio/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/studio.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./flags": {
      "types": "./dist/flags/index.d.ts",
      "import": "./dist/flags/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js"
    },
    "./schedule": {
      "types": "./dist/schedule/index.d.ts",
      "import": "./dist/schedule/index.js"
    },
    "./timetravel": {
      "types": "./dist/timetravel/index.d.ts",
      "import": "./dist/timetravel/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@velajs/studio-protocol": "workspace:^"
  },
  "devDependencies": {
    "@velajs/vela": "^1.20.0",
    "hono": "^4",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@velajs/vela": ">=1.21.0 <2",
    "hono": ">=4"
  },
  "engines": {
    "node": ">=24"
  }
}
