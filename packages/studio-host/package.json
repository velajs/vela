{
  "name": "@velajs/studio-host",
  "version": "1.22.1",
  "description": "Loopback dev host serving the Vela Studio SPA and proxying the admin API",
  "keywords": [
    "admin",
    "dev-server",
    "host",
    "studio",
    "vela"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/studio-host#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/studio-host"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@velajs/studio-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@velajs/studio-ui": "workspace:*",
    "miniflare": "5.20260918.0-alpha",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@velajs/studio-ui": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@velajs/studio-ui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
