{
  "name": "@velajs/studio-ui",
  "version": "1.22.0",
  "description": "Vela Studio admin panel UI (React)",
  "keywords": [
    "admin",
    "react",
    "studio",
    "ui",
    "vela"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/studio-ui#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/studio-ui"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone/index.d.ts",
      "import": "./dist/standalone/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-standalone.mjs",
    "build:lib": "tsdown",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.6",
    "@velajs/studio-protocol": "workspace:*"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@velajs/studio-fixtures": "workspace:*",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
