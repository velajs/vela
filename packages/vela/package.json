{
  "name": "@velajs/vela",
  "version": "1.30.0",
  "description": "NestJS-compatible framework for edge runtimes, powered by Hono",
  "keywords": [
    "bun",
    "cloudflare-workers",
    "decorators",
    "deno",
    "dependency-injection",
    "edge",
    "framework",
    "hono",
    "nestjs",
    "typescript"
  ],
  "homepage": "https://github.com/velajs/vela/tree/main/packages/vela#readme",
  "bugs": {
    "url": "https://github.com/velajs/vela/issues"
  },
  "license": "MIT",
  "author": "ksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velajs/vela.git",
    "directory": "packages/vela"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/metadata.js",
    "./dist/index.js",
    "./dist/module-kit.js",
    "./dist/internal.js",
    "./dist/cache/index.js",
    "./dist/dispatch/index.js",
    "./dist/event-emitter/index.js",
    "./dist/health/index.js",
    "./dist/fetch/index.js",
    "./dist/i18n/index.js",
    "./dist/live/index.js",
    "./dist/logging/index.js",
    "./dist/openapi/index.js",
    "./dist/queue/index.js",
    "./dist/schedule/index.js",
    "./dist/schedule-node/index.js",
    "./dist/security/index.js",
    "./dist/seeder/index.js",
    "./dist/throttler/index.js",
    "./dist/validation/index.js",
    "./dist/websocket/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module-kit": {
      "types": "./dist/module-kit.d.ts",
      "import": "./dist/module-kit.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./dispatch": {
      "types": "./dist/dispatch/index.d.ts",
      "import": "./dist/dispatch/index.js"
    },
    "./events": {
      "types": "./dist/event-emitter/index.d.ts",
      "import": "./dist/event-emitter/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "import": "./dist/health/index.js"
    },
    "./http-client": {
      "types": "./dist/fetch/index.d.ts",
      "import": "./dist/fetch/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "import": "./dist/openapi/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./schedule": {
      "types": "./dist/schedule/index.d.ts",
      "import": "./dist/schedule/index.js"
    },
    "./schedule-node": {
      "types": "./dist/schedule-node/index.d.ts",
      "import": "./dist/schedule-node/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js"
    },
    "./seeder": {
      "types": "./dist/seeder/index.d.ts",
      "import": "./dist/seeder/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./streaming": {
      "types": "./dist/streaming/index.d.ts",
      "import": "./dist/streaming/index.js"
    },
    "./throttler": {
      "types": "./dist/throttler/index.d.ts",
      "import": "./dist/throttler/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "import": "./dist/websocket/index.js"
    },
    "./websocket-node": {
      "types": "./dist/websocket-node/index.d.ts",
      "import": "./dist/websocket-node/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "api:check": "node scripts/api-snapshot.mjs check",
    "api:update": "node scripts/api-snapshot.mjs update",
    "worker-size:check": "node scripts/check-worker-size.mjs",
    "worker-size:update": "node scripts/check-worker-size.mjs --update",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.config.workers.ts",
    "test:workers:als": "vitest run --config vitest.config.workers-als.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.type-tests.json && tsc --noEmit -p tsconfig.dispatch-tests.json && tsc --noEmit -p tsconfig.package-tests.json && tsc --noEmit -p tsconfig.queue-tests.json",
    "check:skill": "node scripts/check-skill.mjs",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm api:check && pnpm worker-size:check && pnpm typecheck && pnpm check:skill && pnpm test && pnpm test:workers && pnpm test:workers:als && pnpm publint && pnpm attw"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "@velajs/errors": "workspace:*",
    "@velajs/live-protocol": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@swc/core": "catalog:",
    "@types/bun": "latest",
    "@vitest/runner": "catalog:",
    "@vitest/snapshot": "catalog:",
    "intl-messageformat": "^11.2.9",
    "miniflare": "5.20260918.0-alpha",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "intl-messageformat": ">=10"
  },
  "peerDependenciesMeta": {
    "intl-messageformat": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
