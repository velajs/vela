{
  "name": "@velajs/studio-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @velajs/studio-ui --filter @velajs/studio-host --filter @velajs/studio --filter @velajs/studio-protocol --workspace-concurrency=1 run build",
    "typecheck": "pnpm --filter @velajs/studio-ui --filter @velajs/studio-host --filter @velajs/studio --filter @velajs/studio-protocol --workspace-concurrency=1 run typecheck",
    "pretest": "pnpm build",
    "test": "pnpm --filter @velajs/studio-ui --filter @velajs/studio-host --filter @velajs/studio --filter @velajs/studio-protocol --workspace-concurrency=1 run test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "pnpm --filter @velajs/studio-protocol --filter @velajs/studio --filter @velajs/studio-ui --filter @velajs/studio-host --no-bail exec publint",
    "attw": "pnpm --filter @velajs/studio-protocol --filter @velajs/studio --filter @velajs/studio-ui --filter @velajs/studio-host --no-bail exec attw --pack . --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm publint && pnpm attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
