{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "resolve",
  "entryPoints": [
    "src/index.ts",
    "src/i18n/index.ts",
    "src/queue/index.ts",
    "src/seeder/index.ts",
    "src/storage/index.ts",
    "src/schedule-node/index.ts",
    "src/websocket/index.ts",
    "src/websocket-node/index.ts",
    "src/streaming/index.ts"
  ],
  "exclude": ["**/*.test.ts", "**/__tests__/**"],
  "out": "api-docs",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "readme": "none",
  "intentionallyNotExported": [
    "ComponentInstance",
    "ComponentType",
    "ComponentTypeMap",
    "ComposedDecorator",
    "ContextType",
    "Contribution",
    "ControllerOptions",
    "ExceptionResponse",
    "HealthIndicatorBuilder",
    "HttpHandlerMeta",
    "InjectMetadata",
    "InjectionTokenOptions",
    "LazyResolutionHook",
    "MiddlewareConfigProxy",
    "ModuleLoader",
    "MountOpenApiOptions",
    "OpenApiSecurityRequirement",
    "OpenApiSecurityScheme",
    "OpenApiServer",
    "ParameterMetadata",
    "RequestConfig",
    "RouteDefinition",
    "SeederModuleOptions",
    "UrlParamValue",
    "ZodLikeSchema"
  ],
  "externalSymbolLinkMappings": {
    "@velajs/vela": {
      "RouteManager": "#"
    }
  }
}
